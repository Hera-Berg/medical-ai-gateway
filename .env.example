# ════════════════════════════════════════════════════════════════════════════
# Medical AI Gateway — environment variables. Copy to `.env` and fill in.
# `docker-compose up` reads `.env` automatically.
# ════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=medgw
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=medgw

# ── RunPod Serverless (LLM inference) ───────────────────────────────────────
# One API key; per-model endpoint IDs live in backend config (models.yaml).
# Leave blank at scaffold stage — inference arrives in build step 11.
RUNPOD_API_KEY=

# ── Qdrant node data directories ────────────────────────────────────────────
# Leave UNSET to use local Docker named volumes (default — Local storage mode).
# To use AWS EBS: set these to the EBS mount paths, e.g.:
#   QDRANT_NODE_1_VOLUME=/mnt/qdrant-node1
#   QDRANT_NODE_2_VOLUME=/mnt/qdrant-node2
QDRANT_NODE_1_VOLUME=
QDRANT_NODE_2_VOLUME=

# ── Cloudflare tunnel ───────────────────────────────────────────────────────
# Get this from `cloudflared tunnel token <name>` or the Zero Trust dashboard.
# See docs/cloudflare-tunnel.md. Leave blank to run local-only on :8090.
CLOUDFLARE_TUNNEL_TOKEN=

# ── AWS (only used when storage backend = AWS) ──────────────────────────────
# Populate via infra/aws-provision.sh, which prints these for you.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
